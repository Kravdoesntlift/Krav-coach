# Your production URL (used in auth email redirect links)
# Locally: http://localhost:3000  |  Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your@email.com

# Anthropic (for AI plan generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Cron secret (generate any random string, e.g.: openssl rand -hex 32)
# Add to Vercel environment variables and vercel.json cron headers
CRON_SECRET=your-random-secret
